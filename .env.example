# EduPath Environment Configuration

# Server
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database (Default: SQLite3 with aiosqlite for zero setup)
# For PostgreSQL: postgresql+asyncpg://user:password@localhost:5432/edupath
DATABASE_URL=sqlite+aiosqlite:///./edupath.db

# Security
JWT_SECRET=edupath-super-secret-production-grade-key-2026-change-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Configuration (Optional: Gemini, OpenAI, or Groq)
# If left empty, EduPath automatically activates the Deterministic AI Engine & Demo Mode.
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_MODEL=gemini-2.0-flash
